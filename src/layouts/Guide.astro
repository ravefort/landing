---
// Layout for the guides at /guides/…: the landing page's tokens and type, a plain top bar and footer,
// and the structured data search engines and AI assistants use to quote an article.
import "../styles/base.css";

interface Props {
  title: string; // the page's search title
  description: string;
  path: string; // e.g. "/guides/reduce-missed-dental-appointments/"
  // An article; leave out on the guides index.
  article?: { headline: string; published: string; modified?: string; faq?: { q: string; a: string }[] };
}
const { title, description, path, article } = Astro.props;
const SITE = "https://ravefort.com";
const url = `${SITE}${path}`;
const DEMO_URL = "/#demo";
const CONTACT_EMAIL = "hello@ravefort.com";

const graph: Record<string, unknown>[] = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ravefort", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Guides", item: `${SITE}/guides/` },
      ...(article ? [{ "@type": "ListItem", position: 3, name: article.headline, item: url }] : []),
    ],
  },
];
if (article) {
  graph.push({
    "@type": "Article",
    headline: article.headline,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: "en-NG",
    datePublished: article.published,
    dateModified: article.modified ?? article.published,
    image: `${SITE}/og.png`,
    author: { "@type": "Organization", name: "Ravefort", url: SITE },
    publisher: { "@type": "Organization", name: "Ravefort", url: SITE, email: CONTACT_EMAIL },
    about: ["Dental clinics", "Missed appointments", "Patient recall", "Nigeria"],
  });
  if (article.faq?.length)
    graph.push({
      "@type": "FAQPage",
      mainEntity: article.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    });
}
const structuredData = { "@context": "https://schema.org", "@graph": graph };
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#171717"/><text x="12" y="17" font-family="Inter,sans-serif" font-size="14" font-weight="600" text-anchor="middle" fill="#fafafa">R</text></svg>',
  );
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href={favicon} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:site_name" content="Ravefort" />
    <meta property="og:title" content={article?.headline ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={article.published} />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <header class="g-nav">
      <nav aria-label="Main" class="wrap g-nav-row">
        <a href="/" class="g-brand" aria-label="Ravefort home"><span class="g-logo" aria-hidden="true">R</span><span>Ravefort</span></a>
        <div class="g-nav-end">
          <a href="/guides/" class="g-nav-link">Guides</a>
          <a href={DEMO_URL} class="btn btn-primary btn-sm">Book a demo</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="g-foot">
      <div class="wrap g-foot-row">
        <p class="t-body-sm muted">Ravefort · Dental clinic software for Lagos, Abuja, Port Harcourt and the rest of Nigeria.</p>
        <p class="t-body-sm"><a href="/">Home</a> · <a href="/guides/">Guides</a> · <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .g-nav { position: sticky; top: 0; z-index: 2; background: rgba(255, 255, 255, 0.85); border-bottom: 1px solid var(--border); -webkit-backdrop-filter: blur(16px) saturate(180%); backdrop-filter: blur(16px) saturate(180%); }
  .g-nav-row { height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .g-brand { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 18px; letter-spacing: -0.02em; }
  .g-logo { width: 28px; height: 28px; border-radius: var(--radius-logo); background: var(--primary); color: var(--primary-foreground); display: grid; place-items: center; font-size: 15px; font-weight: 600; }
  .g-nav-end { display: flex; align-items: center; gap: 20px; }
  .g-nav-link { font-size: 14px; font-weight: 500; color: var(--muted-foreground); }
  .g-nav-link:hover { color: var(--foreground); }

  .g-foot { border-top: 1px solid var(--border); margin-top: 96px; padding: 32px 0; }
  .g-foot-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .g-foot a { text-decoration: underline; text-underline-offset: 3px; }

  /* Article body: a readable measure, generous spacing, the landing page's type scale. */
  .g-article { max-width: 720px; margin: 0 auto; padding: 56px 32px 0; box-sizing: border-box; }
  .g-crumbs { font-size: 14px; color: var(--muted-foreground); margin-bottom: 24px; }
  .g-crumbs a { color: var(--muted-foreground); }
  .g-crumbs a:hover { color: var(--foreground); }
  .g-article h1 { font: 700 44px/50px var(--font-sans); letter-spacing: -0.025em; text-wrap: balance; }
  .g-meta { margin-top: 16px; font-size: 14px; color: var(--muted-foreground); }
  .g-answer { margin-top: 32px; padding: 24px; border-radius: var(--radius-card); background: var(--secondary); }
  .g-answer p { font-size: 18px; line-height: 28px; color: var(--primary); }
  .g-answer strong { display: block; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 8px; }
  .g-article h2 { margin-top: 56px; font: 600 28px/34px var(--font-sans); letter-spacing: -0.02em; text-wrap: balance; }
  .g-article h3 { margin-top: 32px; font: 600 20px/28px var(--font-sans); letter-spacing: -0.017em; }
  .g-article p, .g-article li { font-size: 17px; line-height: 28px; color: var(--primary); }
  .g-article h2 + p, .g-article h3 + p, .g-article p + p, .g-article p + ul, .g-article ul + p, .g-article p + ol { margin-top: 16px; }
  .g-article ul, .g-article ol { margin: 16px 0 0; padding-left: 24px; }
  .g-article li + li { margin-top: 8px; }
  .g-article a { text-decoration: underline; text-underline-offset: 3px; }
  .g-template { margin-top: 16px; padding: 16px 20px; border-left: 3px solid var(--success); border-radius: 0 var(--radius-card) var(--radius-card) 0; background: var(--surface); font-size: 16px; line-height: 26px; white-space: pre-line; }
  .g-template-label { margin-top: 24px; font-size: 14px; font-weight: 600; color: var(--muted-foreground); }
  .g-cta { margin-top: 64px; padding: 32px; border-radius: var(--radius-frame); background: var(--primary); color: var(--primary-foreground); }
  .g-cta h2 { margin-top: 0; color: var(--primary-foreground); }
  .g-cta p { margin-top: 12px; color: #d4d4d4; }
  .g-cta .btn { margin-top: 24px; background: var(--primary-foreground); color: var(--primary); text-decoration: none; }
  .g-faq h3 { margin-top: 28px; }

  @container (max-width: 760px) {
    .wrap { padding: 0 16px; }
    .g-article { padding: 32px 16px 0; }
    .g-article h1 { font-size: 32px; line-height: 38px; }
    .g-article h2 { margin-top: 44px; font-size: 24px; line-height: 30px; }
    .g-nav-link { display: none; }
    .g-cta { padding: 24px; }
  }
</style>
