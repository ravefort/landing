    <script>
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");

      // A little directional travel prevents touch inertia from repeatedly reversing the header.
      // The glass fades independently of the bar as it crosses back over the hero.
      const nav = document.getElementById("nav")!;
      const hero = document.querySelector<HTMLElement>(".v4-hero");
      const tabbing = () => !!nav.querySelector(":focus-visible");
      let lastY = Math.max(0, scrollY);
      let travel = 0;
      let navFrame = 0;
      const onScroll = () => {
        navFrame = 0;
        const y = Math.max(0, scrollY);
        const delta = y - lastY;
        if (delta) travel = Math.sign(delta) === Math.sign(travel) ? travel + delta : delta;
        const navHeight = nav.offsetHeight;
        // Keep the glass while hero copy passes behind the header; fade it near the top photo.
        const overHero = hero && y <= hero.offsetTop + navHeight;
        nav.classList.toggle("is-scrolled", hero ? !overHero : y > 8);
        const menuOpen = !!nav.querySelector("dialog[open]");
        if (y <= navHeight || tabbing() || menuOpen || travel <= -8) nav.classList.remove("is-hidden");
        else if (travel >= 12) nav.classList.add("is-hidden");
        lastY = y;
      };
      const queueNav = () => { if (!navFrame) navFrame = requestAnimationFrame(onScroll); };
      addEventListener("scroll", queueNav, { passive: true });
      addEventListener("resize", queueNav);
      nav.addEventListener("focusin", () => { if (tabbing()) nav.classList.remove("is-hidden"); });
      onScroll();

      // Section reveal: once, when 15% of the element is on screen.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.dataset.inAt = String(performance.now());
            // A card's rows wait for the card to land, unless it landed a while ago off to the side
            // and has only now been scrolled into view.
            if (el.hasAttribute("data-fill")) {
              const row = el.closest<HTMLElement>("[data-reveal-group]");
              if (row?.dataset.inAt && performance.now() - Number(row.dataset.inAt) > 600) el.style.setProperty("--fd", "0ms");
            }
            el.classList.add("is-in");
            io.unobserve(el);
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll("[data-reveal], [data-reveal-group], [data-words], [data-fill]").forEach((el) => io.observe(el));

      // Stacked cards: as the next card slides over, the one underneath shrinks to 0.96. It follows
      // the scroll position, with no timer, and only while the cards stick (not on phones).
      const hcCards = [...document.querySelectorAll<HTMLElement>(".hc-card")];
      if (hcCards.length) {
        let queued = false;
        const settle = () => {
          queued = false;
          const still = reduce.matches || getComputedStyle(hcCards[0]).position !== "sticky";
          hcCards.forEach((card, i) => {
            const next = hcCards[i + 1];
            if (still || !next) return card.style.removeProperty("--hc-scale");
            const stuckAt = parseFloat(getComputedStyle(card).top);
            const h = card.offsetHeight;
            // 0 when the next card reaches this card's bottom edge, 1 when it has stuck 16px lower.
            const p = Math.min(1, Math.max(0, (stuckAt + h - next.getBoundingClientRect().top) / (h - 16)));
            card.style.setProperty("--hc-scale", String(1 - 0.04 * p));
          });
        };
        const queue = () => { if (!queued) { queued = true; requestAnimationFrame(settle); } };
        addEventListener("scroll", queue, { passive: true });
        addEventListener("resize", queue);
        reduce.addEventListener("change", queue);
        settle();
      }

      // Person cards: previous / next scroll by one card plus the gap, and switch off at either end.
      const row = document.getElementById("who-row")!;
      const navBtns = document.querySelectorAll<HTMLButtonElement>(".pc-nav");
      const updateEnds = () => {
        const max = row.scrollWidth - row.clientWidth;
        navBtns.forEach((b) => {
          b.disabled = b.dataset.dir === "-1" ? row.scrollLeft <= 1 : row.scrollLeft >= max - 1;
        });
      };
      navBtns.forEach((b) =>
        b.addEventListener("click", () => {
          const card = row.querySelector<HTMLElement>(".pc")!;
          const step = card.getBoundingClientRect().width + parseFloat(getComputedStyle(row).columnGap);
          row.scrollBy({ left: Number(b.dataset.dir) * step });
        }),
      );
      row.addEventListener("scroll", updateEnds, { passive: true });
      addEventListener("resize", updateEnds);
      updateEnds();

      // How it works (version B): picking a step opens its sentence and cross-fades the picture.
      const hb = document.getElementById("hb");
      if (hb) hb.querySelectorAll<HTMLButtonElement>(".hb-step").forEach((btn) =>
        btn.addEventListener("click", () => {
          const n = btn.dataset.step;
          hb.querySelectorAll<HTMLButtonElement>(".hb-step").forEach((b) => {
            const open = b.dataset.step === n;
            b.setAttribute("aria-expanded", String(open));
            b.parentElement!.classList.toggle("is-open", open);
          });
          hb.querySelectorAll<HTMLElement>(".hb-pic").forEach((p) => {
            const on = p.dataset.pic === n;
            p.classList.toggle("is-active", on);
            if (on) p.removeAttribute("aria-hidden");
            else p.setAttribute("aria-hidden", "true");
          });
        }),
      );

      // How it works (version D): picking a step moves the grey block and its line, and the picture
      // cross-fades while its panel changes grey.
      const hd = document.getElementById("hd");
      if (hd) {
        const pic = hd.querySelector<HTMLElement>(".hd-pic")!;
        hd.querySelectorAll<HTMLButtonElement>(".hd-step").forEach((btn) =>
          btn.addEventListener("click", () => {
            const n = btn.dataset.step!;
            hd.querySelectorAll<HTMLButtonElement>(".hd-step").forEach((b) => {
              const open = b.dataset.step === n;
              b.setAttribute("aria-expanded", String(open));
              b.classList.toggle("is-open", open);
            });
            pic.dataset.tone = n;
            hd.querySelectorAll<HTMLElement>(".hd-shot").forEach((p) => {
              const on = p.dataset.pic === n;
              p.classList.toggle("is-active", on);
              if (on) p.removeAttribute("aria-hidden");
              else p.setAttribute("aria-hidden", "true");
            });
          }),
        );
      }

      // FAQ: <details> stays the source of truth; .is-open drives the height and chevron, so closing
      // can animate before the answer is hidden. Several can be open at once.
      const nextFrame = (fn: () => void) => requestAnimationFrame(() => requestAnimationFrame(fn));
      document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((d) => {
        d.querySelector("summary")!.addEventListener("click", (e) => {
          e.preventDefault();
          if (d.classList.contains("is-open")) {
            d.classList.remove("is-open");
            const hide = () => { if (!d.classList.contains("is-open")) d.open = false; };
            if (reduce.matches) hide();
            else setTimeout(hide, 200);
          } else if (d.open) {
            nextFrame(() => d.classList.add("is-open"));
          } else {
            d.open = true;
          }
        });
        // Also catches the browser opening one itself, for find-in-page.
        d.addEventListener("toggle", () => {
          if (!d.open) d.classList.remove("is-open");
          else if (!d.classList.contains("is-open")) nextFrame(() => d.classList.add("is-open"));
        });
      });
    </script>
  </body>
</html>

