---
import Words from "./Words.astro";
import MobileMenu from "./MobileMenu.astro";

// Ported from "Copy v1" on the Ravefort MVP design canvas (Landing-Copy-v1), with the
// Copy v1 motion spec: section reveals, hero load, person-card row, How it works (version B), FAQ.
// Version 2 swaps in two other canvas sections: the photo hero "After Ploy · 1, two at the desk"
// (Landing-Hero-Ploy) and How it works version C, stacked cards (Landing-HowItWorks-C).
// Version 3 uses "Hero with photo · C", text on a panel (Landing-Hero-Photo-C), and How it works
// version D, picture left and steps right (Landing-HowItWorks-D).
// Version 4 (Figma 258:9385 hero, 258:11101 step cards) is the homepage. Only the page passed
// `indexed` is open to search; the rest point their canonical at / and carry noindex.
interface Props {
  version?: 1 | 2 | 3 | 4;
  indexed?: boolean;
}
const { version = 1, indexed = false } = Astro.props;
// ponytail: links still to confirm before launch: the demo booking link, the app's sign-in URL,
// and Privacy/Terms pages.
const DEMO_URL = "#demo";
const CONTACT_EMAIL = "hello@ravefort.com";
const TALK_URL = `mailto:${CONTACT_EMAIL}`;
// Empty hides the Sign in links until the app has a public address.
const SIGN_IN_URL = "";
// Empty hides the Legal column until the pages exist.
const PRIVACY_URL = "";
const TERMS_URL = "";

const heroH = "Never lose track of a patient again";
const heroSub =
  "Ravefort is the clinic system that puts your diary, patient records and recall list in one place, so your team always knows who’s due back and nobody falls through the cracks.";
const heroSubPhoto =
  "Ravefort puts your diary, patient records and recall list in one place, so your team always knows who’s due back.";

type Pill = { label: string; c: string };
const people: { title: string; body: string }[] = [
  { title: "Clinic owner", body: "See who’s due back and what their return could be worth. Reports are coming next." },
  { title: "Front desk", body: "See today’s patients on one screen, and book, check in or move them in a click." },
  { title: "Recall team", body: "Know who’s due back and what happened on the last call, so nobody is called twice." },
  { title: "Your team", body: "Give each person a role, and they only see what that role allows." },
];
const deskRows: { time: string; name: string; pill: Pill }[] = [
  { time: "09:00", name: "Ngozi Adeyemi", pill: { label: "Checked in", c: "status-arrived" } },
  { time: "09:30", name: "Tunde Bakare", pill: { label: "Waiting", c: "status-scheduled" } },
  { time: "10:00", name: "Kola Bello", pill: { label: "No-show", c: "status-no-show" } },
];
const recallRows: { name: string; note: string; pill: Pill }[] = [
  { name: "Kola Bello", note: "Called Tue · no answer", pill: { label: "Call back Thu", c: "warning" } },
  { name: "Bola Johnson", note: "Check-up due in May", pill: { label: "To call", c: "info" } },
  { name: "Ngozi Adeyemi", note: "Booked on the call", pill: { label: "Booked", c: "success" } },
];
const teamRows = [
  { initials: "AO", name: "Amaka Okafor", role: "Owner" },
  { initials: "TA", name: "Tola Adebayo", role: "Front desk" },
];

const icons = {
  calendar: { rule: "evenodd", d: "M5.25 5.497a.75.75 0 0 1-.75-.75V4A1.5 1.5 0 0 0 3 5.5v1h10v-1A1.5 1.5 0 0 0 11.5 4v.75a.75.75 0 0 1-1.5 0V4H6v.747a.75.75 0 0 1-.75.75M10 2.5H6v-.752a.75.75 0 1 0-1.5 0V2.5a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h7a3 3 0 0 0 3-3v-6a3 3 0 0 0-3-3v-.75a.75.75 0 0 0-1.5 0zM3 8v3.5A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5V8z" },
  person: { rule: "nonzero", d: "M8 8.5c3.85 0 7 2.5 7 4.5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2c0-2 3.15-4.5 7-4.5M8 10c-1.61 0-3.064.526-4.092 1.234C2.798 12.001 2.5 12.733 2.5 13a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5c0-.267-.297-1-1.408-1.766C11.064 10.526 9.609 10 8 10m0-9a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7m0 1.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4" },
  recall: { rule: "evenodd", d: "M8 1.5a6.5 6.5 0 1 1-6.445 7.348.75.75 0 1 1 1.487-.194A5.001 5.001 0 1 0 4.43 4.5h1.32a.75.75 0 0 1 0 1.5h-3A.75.75 0 0 1 2 5.25v-3a.75.75 0 0 1 1.5 0v1.06A6.48 6.48 0 0 1 8 1.5" },
  whatsapp: { rule: "evenodd", d: "m4.843 10.944-.194 2.335a.204.204 0 0 0 .339.17l2.21-1.964.589.013L8 11.5c1.695 0 3.087-.44 4.020-1.177.89-.702 1.48-1.76 1.48-3.323s-.59-2.62-1.48-3.323C11.087 2.94 9.695 2.5 8 2.5s-3.087.44-4.020 1.177C3.09 4.38 2.5 5.437 2.5 7c0 1.648.656 2.742 1.648 3.448zm1.141 3.625 1.77-1.572Q7.875 13 8 13c3.866 0 7-2 7-6s-3.134-6-7-6-7 2-7 6c0 2.117.878 3.674 2.277 4.67l-.123 1.484a1.704 1.704 0 0 0 2.83 1.415" },
  upload: { rule: "evenodd", d: "M7.47 1.22a.75.75 0 0 1 1.06 0l2.5 2.5a.75.75 0 1 1-1.06 1.06L8.75 3.56v7.69a.75.75 0 0 1-1.5 0V3.56L6.03 4.78a.75.75 0 0 1-1.06-1.06zM1.75 13.5a.75.75 0 0 0 0 1.5h12.5a.75.75 0 0 0 0-1.5z" },
  shield: { rule: "evenodd", d: "m3.003 4.702 4.22-2.025a1.8 1.8 0 0 1 1.554 0l4.22 2.025a.89.89 0 0 1 .503.8V6a8.55 8.55 0 0 1-3.941 7.201l-.986.631a1.06 1.06 0 0 1-1.146 0l-.986-.63A8.55 8.55 0 0 1 2.5 6v-.498c0-.341.196-.652.503-.8m3.57-3.377L2.354 3.35A2.39 2.39 0 0 0 1 5.502V6a10.05 10.05 0 0 0 4.632 8.465l.986.63a2.56 2.56 0 0 0 2.764 0l.986-.63A10.05 10.05 0 0 0 15 6v-.498c0-.918-.526-1.755-1.354-2.152l-4.22-2.025a3.3 3.3 0 0 0-2.852 0M11.1 6.45a.75.75 0 1 0-1.2-.9L7.419 8.858 6.03 7.47a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.13-.08z" },
};
const features = [
  { icon: icons.calendar, title: "Appointments", body: "Book, check in, move or cancel from one shared diary. Late arrivals and no-shows stand out on their own." },
  { icon: icons.person, title: "Patient records", body: "One record for each person, with their visits, bookings and payments. Find anyone by name or phone number." },
  { icon: icons.recall, title: "Recall list", body: "Set how often patients should come back, once. Ravefort lists who’s due, each person once, and every call is noted." },
  { icon: icons.whatsapp, title: "WhatsApp messages", body: "Open a ready-made message to the patient in WhatsApp. Then note what happened on their record." },
  { icon: icons.upload, title: "Record import", body: "Upload the CSV or Excel files from your old system. Fix rows in the review, and nothing is merged without you deciding." },
  { icon: icons.shield, title: "Team access", body: "Invite staff by email and give each person a role. Front desk staff never see clinical notes." },
];

// ponytail: step 1 has no screenshot yet; it shows the canvas's placeholder until one is made.
const steps: { title: string; body: string; src?: string; alt?: string; note?: string; more: string }[] = [
  { title: "Set up your clinic", body: "Sign up with your work email and your clinic is ready to use.", note: "From onboarding: the Create your clinic form, filled in.", more: "from your work email" },
  { title: "Bring your patients", body: "Your existing records come with you, checked before anything is saved.", src: "/shots/import-review.webp", alt: "Reviewing uploaded patient records before they are saved", more: "with the records you keep" },
  { title: "Set up recall", body: "Ravefort works out who’s due back, so no patient gets forgotten.", src: "/shots/recall.webp", alt: "The Recall board: patients due back sorted into to call, calling, call back and booked", more: "and see who’s due back" },
  { title: "Invite your team", body: "Everyone works from the same records and sees only what their role allows.", src: "/shots/team.webp", alt: "Team & access: each member with their role and status", more: "each with the right access" },
];
const v4Pictures = [
  { name: "setup", alt: "Welcome to Ravefort: your clinic is ready, with patients and team invited.", x: 117.27, y: 80, w: 412.211, h: 367.125 },
  { name: "import", alt: "Patient import review with ready, needs a fix and possible duplicate statuses.", x: 25.27, y: 127, w: 593.333, h: 267 },
  { name: "recall", alt: "Recall funnel showing patients due, contacted, booked and returned.", x: 81.27, y: 47, w: 484, h: 433.287 },
  { name: "team", alt: "Invite your team by work email and assign Manager, Recall or Clinician access.", x: 76.27, y: 30, w: 493, h: 468 },
];
const OPEN_STEP = 1;

// ponytail: the two [NEED: …] answers must be filled in before this goes live.
const faq = [
// Questions are phrased the way clinic owners search and ask AI assistants, so answers can be quoted as they are.
  { q: "Who is Ravefort for?", a: "Dental clinics in Nigeria, with a focus on Lagos, Abuja and Port Harcourt. It suits any clinic that sees patients more than once and wants them to come back." },
  { q: "Can dental clinics in Lagos, Abuja and Port Harcourt use Ravefort?", a: "Yes. Ravefort runs in a web browser, so there’s nothing to install and any clinic in Nigeria can use it. Book a demo and we’ll take you through it." },
  { q: "How does Ravefort reduce missed appointments?", a: "No-shows and late arrivals stand out in the day’s diary, and the recall list shows everyone who’s overdue, each person once. Your team sends a ready-made WhatsApp message or calls, then notes what happened. Automatic reminders are coming next." },
  { q: "Can we bring our patient records from Excel or another system?", a: "Yes. Upload them as CSV or Excel files and check every row before it’s saved. Nothing is merged without you deciding." },
  { q: "Does Ravefort message patients for us?", a: "Not yet. Your team opens a ready-made WhatsApp message or calls, then notes what happened on the patient’s record." },
  { q: "Who can see our patients’ information?", a: "Only the people you invite, and only what their role allows. Your records are kept apart from every other clinic’s." },
  { q: "How is “could be worth” worked out?", a: "It’s an estimate, and always labelled as one. A return only counts once the visit is done and paid." },
  { q: "What’s coming next?", a: "Reports on who came back and which follow-ups worked, online booking and automatic reminders." },
  { q: "How long does set-up take?", a: "[NEED: typical set-up time.] We go through each step with you on your demo." },
  { q: "How much does it cost?", a: "[NEED: pricing.] We’ll talk it through on your demo." },
];
const navLinks = [
  ["#product", "Product"],
  ["#how", "How it works"],
  ["#who", "Who it’s for"],
  ["#questions", "FAQ"],
];

const pill = (p: Pill) => `background: var(--${p.c}-soft);`;
const dot = (p: Pill) => `background: var(--${p.c});`;
const arrowPath =
  "M1.25 8A.75.75 0 0 1 2 7.25h10.19L9.47 4.53a.75.75 0 0 1 1.06-1.06l4 4a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 1 1-1.06-1.06l2.72-2.72H2A.75.75 0 0 1 1.25 8";
const chevronPath =
  "M2.97 5.47a.75.75 0 0 1 1.06 0L8 9.44l3.97-3.97a.75.75 0 1 1 1.06 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 0 1 0-1.06";
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#171717"/><text x="12" y="17" font-family="Inter,sans-serif" font-size="14" font-weight="600" text-anchor="middle" fill="#fafafa">R</text></svg>',
  );
const SITE = "https://ravefort.com";
// Search: dental clinics in Nigeria, Lagos first, then Abuja and Port Harcourt. The goal is a demo.
const CITIES = ["Lagos", "Abuja", "Port Harcourt"];
// Titles cut off around 60 characters, snippets around 160.
const title = "Dental Clinic Software in Lagos, Abuja & Port Harcourt | Ravefort";
const description =
  "Appointments, patient records and recall for dental clinics in Lagos, Abuja and Port Harcourt. Bring patients back on WhatsApp. Book a demo.";

// What search engines and AI assistants read about the business and the product.
const areaServed = [...CITIES.map((name) => ({ "@type": "City", name, containedInPlace: { "@type": "Country", name: "Nigeria" } })), { "@type": "Country", name: "Nigeria" }];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Ravefort",
      url: SITE,
      email: CONTACT_EMAIL,
      description,
      areaServed,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "Ravefort",
      inLanguage: "en-NG",
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      name: "Ravefort",
      url: SITE,
      description: heroSub,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Dental practice management",
      keywords: "dental clinic software, dental practice management software, patient recall, appointment booking, WhatsApp patient messages, Lagos, Abuja, Port Harcourt, Nigeria",
      potentialAction: { "@type": "ScheduleAction", name: "Book a demo", target: `mailto:${CONTACT_EMAIL}?subject=Ravefort%20demo` },
      operatingSystem: "Web browser",
      areaServed,
      audience: { "@type": "BusinessAudience", audienceType: "Dental clinics in Lagos, Abuja, Port Harcourt and across Nigeria", geographicArea: areaServed },
      featureList: features.map((f) => `${f.title}: ${f.body}`),
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": "FAQPage",
      // Answers still waiting on facts stay out of what search engines read.
      mainEntity: faq
        .filter((f) => !f.a.includes("[NEED"))
        .map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- A reload starts at the top. Restoring the old scroll position painted one frame before the
         page script ran (bar see-through, cards full size, text hidden), then everything snapped.
         A link to a section (#how) jumps straight there while loading; smooth scrolling is only for
         clicks on the page's own links. -->
    <script is:inline>
      {
        const root = document.documentElement;
        root.classList.add("js");
        history.scrollRestoration = "manual";
        root.style.scrollBehavior = "auto";
        addEventListener("load", () => requestAnimationFrame(() => root.style.removeProperty("scroll-behavior")));
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexed && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="alternate" hreflang="en-NG" href={`${SITE}/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <meta name="geo.region" content="NG" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ravefort" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ravefort: run your front desk, bring your patients back." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    {version === 4 && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400&display=swap" />}
  </head>
  <body class={`v${version}`}>
    <header class="nav" id="nav">
      <nav aria-label="Main" class="wrap nav-row">
        <a href="#top" aria-label="Ravefort home" class="brand"><span class="logo" aria-hidden="true">R</span><span>Ravefort</span></a>
        <div class="nav-links">
          {navLinks.map(([href, label]) => <a href={href}>{label}</a>)}
        </div>
        <div class="nav-end">
          {SIGN_IN_URL && <a href={SIGN_IN_URL} class="nav-signin">Sign in</a>}
          <a href={DEMO_URL} class="btn btn-primary btn-sm">Book a demo</a>
          {version === 4 && <MobileMenu links={navLinks} demoUrl={DEMO_URL} />}
        </div>
      </nav>
    </header>

    <main id="top">
      {version === 4 && (
        <div class="v4-hero-wrap">
          <section class="v4-hero" aria-labelledby="hero-h">
            <div class="v4-hero-photo">
              <img src="/photos/hero-clinic-2400.webp" srcset="/photos/hero-clinic-1280.webp 1280w, /photos/hero-clinic-2400.webp 2400w" sizes="100vw" width="2400" height="1340" fetchpriority="high" alt="A clinician in a white coat working at her laptop in a sunlit clinic." />
            </div>
            <div class="wrap v4-hero-content">
              <h1 id="hero-h"><Words text="The clinic operations suite for teams who can’t afford to lose a patient." /></h1>
              <p class="hero-in" style="--i: 0">Your front desk, recall team and clinicians share one record for every patient, so patients don’t have to repeat themselves and you can see who needs attention.</p>
              <div class="v4-hero-buttons hero-in" style="--i: 1">
                <a class="btn btn-primary" href={DEMO_URL}>Book a demo</a>
                <a class="btn v4-talk" href={TALK_URL}>Talk to us</a>
              </div>
            </div>
          </section>
        </div>
      )}
      {version === 2 && (
      <div class="ph-wrap">
        <section class="ph-frame theme-dark" aria-labelledby="hero-h">
          <img class="ph-img" src="/photos/hero-desk.webp" width="1024" height="572" fetchpriority="high" alt="A clinician at her desk smiling at the screen while a colleague leans in beside her" />
          <div class="ph-text">
            <h1 id="hero-h" class="ph-h1"><Words text={heroH} /></h1>
            <p class="ph-sub hero-in" style="--i: 0">{heroSubPhoto}</p>
            <div class="ph-btns hero-in" style="--i: 1">
              <a class="btn btn-primary" href={DEMO_URL}>Book a demo</a>
              <a class="btn btn-outline" href={TALK_URL}>Talk to us</a>
            </div>
          </div>
        </section>
      </div>
      )}
      {version === 3 && (
      <section class="pc-hero" aria-labelledby="hero-h">
        <div class="stage">
          <div class="stage-pic">
            <img src="/photos/hero-clinician.webp" width="1024" height="572" fetchpriority="high" alt="A smiling clinician in a white coat sits at a desk, pen in hand, looking at a computer screen." />
          </div>
          <div class="panel">
            <h1 id="hero-h" class="panel-h1"><Words text={heroH} /></h1>
            <p class="hero-sub hero-in" style="max-width: 520px; --i: 0">{heroSub}</p>
            <div class="panel-ctas hero-in" style="--i: 1">
              <a class="btn btn-primary" href={DEMO_URL}>Book a demo</a>
              <a class="btn btn-outline" href={TALK_URL}>Talk to us</a>
            </div>
          </div>
        </div>
      </section>
      )}
      {version === 1 && (
      <section class="hero" aria-labelledby="hero-h">
        <div class="wrap hero-text">
          <h1 id="hero-h" class="t-display">
            <Words text={heroH} />
          </h1>
          <p class="hero-sub hero-in" style="--i: 0">{heroSub}</p>
          <div class="hero-ctas hero-in" style="--i: 1">
            <a class="btn btn-primary" href={DEMO_URL}>Book a demo</a>
            <a class="btn btn-outline" href={TALK_URL}>Talk to us</a>
          </div>
        </div>
        <div class="wrap hero-shot">
          <div class="shot-panel">
            <img src="/shots/appointments.webp" width="2000" height="1142" fetchpriority="high" alt="Ravefort’s Appointments calendar for one day, with each booking showing its status" />
          </div>
        </div>
      </section>
      )}

      <section id="who" class="sec" aria-labelledby="who-h">
        <div class="wrap">
          <h2 id="who-h" class="t-title" data-words><Words text="Five places your patients get lost, now one." /></h2>
          <p class="t-title sec-sub muted" data-words><Words text="Clear for the owner. Simple for the front desk." start={8} /></p>
        </div>
        <div class="pc-row" id="who-row" data-reveal-group style="--stagger: 50ms; --d: 250ms">
          {people.map((p, i) => (
            <article class="pc" style={`--i: ${i}`}>
              <div class="pc-text">
                <h3 class="t-heading-lg">{p.title}</h3>
                <p class="body">{p.body}</p>
              </div>
              <div class="pc-pic" aria-hidden="true">
                <div class="mini" data-fill>
                  {i === 0 && (
                    <>
                      <div class="tile stack-4">
                        <span class="t-caption muted">Due back this month</span>
                        <span class="t-title">48</span>
                      </div>
                      <div class="tile line">
                        <span class="grow stack-6"><span class="t-caption muted">Could be worth</span><span class="bar"></span></span>
                        <span class="pill" style={pill({ label: "", c: "warning" })}><span class="dot" style={dot({ label: "", c: "warning" })}></span>Estimate</span>
                      </div>
                    </>
                  )}
                  {i === 1 && deskRows.map((r) => (
                    <div class="tile line">
                      <span class="t-caption muted time">{r.time}</span>
                      <span class="grow name">{r.name}</span>
                      <span class="pill" style={pill(r.pill)}><span class="dot" style={dot(r.pill)}></span>{r.pill.label}</span>
                    </div>
                  ))}
                  {i === 2 && recallRows.map((r) => (
                    <div class="tile line">
                      <span class="grow stack-2"><span class="name">{r.name}</span><span class="t-caption muted">{r.note}</span></span>
                      <span class="pill" style={pill(r.pill)}><span class="dot" style={dot(r.pill)}></span>{r.pill.label}</span>
                    </div>
                  ))}
                  {i === 3 && (
                    <>
                      {teamRows.map((r) => (
                        <div class="tile line">
                          <span class="avatar">{r.initials}</span>
                          <span class="grow name">{r.name}</span>
                          <span class="t-caption muted">{r.role}</span>
                        </div>
                      ))}
                      <div class="tile line">
                        <span class="avatar dashed"></span>
