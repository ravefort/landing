    --accent: rgba(255, 255, 255, 0.06);
    --border: rgba(255, 255, 255, 0.1);
    --input: rgba(255, 255, 255, 0.15);
    --frame: #1b1b1b;
    --ring: #a3a3a3;
    --shadow-color: rgba(0, 0, 0, 0.5);
    --control-border: rgba(255, 255, 255, 0.35);
    color-scheme: dark;
  }

  html { scroll-behavior: smooth; scroll-padding-top: 88px; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--background);
    color: var(--foreground);
    font: 400 16px/24px var(--font-sans);
    -webkit-font-smoothing: antialiased;
    container-type: inline-size;
  }
  p, h1, h2, h3, figure { margin: 0; }
  a { color: var(--foreground); text-decoration: none; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }

  .t-display { font: 700 36px/40px var(--font-sans); letter-spacing: -0.022em; }
  .t-title { font: 600 30px/36px var(--font-sans); letter-spacing: -0.021em; }
  .t-heading-lg { font: 600 20px/28px var(--font-sans); letter-spacing: -0.017em; }
  .t-heading-base { font: 600 16px/24px var(--font-sans); letter-spacing: -0.011em; }
  .t-heading-sm { font: 600 14px/20px var(--font-sans); }
  .t-body-sm { font-size: 14px; line-height: 20px; }
  .t-caption { font-size: 12px; line-height: 16px; }
  .body { font-size: 16px; line-height: 24px; color: var(--primary); }
  .lead { font-size: 20px; line-height: 28px; color: var(--primary); text-wrap: pretty; }
  .muted { color: var(--muted-foreground); }
  .mono { font-family: var(--font-mono); }
  .kicker { font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-foreground); }

  .wrap { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 32px; box-sizing: border-box; }
  .stack-2, .stack-4, .stack-6, .stack-12, .stack-48 { display: flex; flex-direction: column; }
  .stack-2 { gap: 2px; } .stack-4 { gap: 4px; } .stack-6 { gap: 6px; } .stack-12 { gap: 12px; } .stack-48 { gap: 48px; }
  .grow { flex: 1; min-width: 0; }

  .btn {
    height: 44px; padding: 0 20px; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: var(--radius-pill); font-size: 16px; line-height: 24px; font-weight: 500; white-space: nowrap;
    transition: background-color 150ms var(--ease-in-out), transform 150ms var(--ease-out);
  }
  .btn-sm { font-size: 14px; line-height: 20px; padding: 0 16px; }
  .btn-primary { background: var(--primary); color: var(--primary-foreground); }
  .btn-outline { border: 1px solid var(--input); color: var(--foreground); }

  /* Top bar */
  .nav {
    position: sticky; top: 0; z-index: 2;
    background: transparent; border-bottom: 1px solid transparent;
    transition: background-color 200ms var(--ease-in-out), border-color 200ms var(--ease-in-out);
  }
  .nav.is-scrolled { background: var(--background); border-bottom-color: var(--border); }
  .nav-row { height: 72px; display: flex; align-items: center; gap: 32px; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 600; letter-spacing: -0.011em; }
  .logo {
    width: 28px; height: 28px; border-radius: var(--radius-logo); background: var(--primary); color: var(--primary-foreground);
    display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700;
  }
  .nav-links { flex: 1; display: flex; justify-content: center; gap: 32px; }
  .nav-links a { font-size: 14px; line-height: 20px; color: var(--muted-foreground); transition: color 150ms var(--ease-in-out); }
  .nav-end { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .nav-signin { min-height: 44px; padding: 0 12px; display: inline-flex; align-items: center; font-size: 14px; line-height: 20px; font-weight: 500; transition: color 150ms var(--ease-in-out); }

  /* Hero */
  .hero { padding: 96px 0 64px; }
  .hero-text { display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
  .hero-text h1 { max-width: 720px; text-wrap: balance; }
  .hero-sub { max-width: 640px; font-size: 20px; line-height: 28px; color: var(--primary); text-wrap: pretty; }
  .hero-ctas { display: flex; gap: 12px; margin-top: 8px; }
  .hero-shot { margin-top: 48px; }
  .shot-panel { border-radius: var(--radius-frame); background: var(--frame); padding: 48px 0 0 48px; overflow: hidden; }
  .shot-panel img { display: block; width: 100%; height: auto; border-radius: var(--radius-card) 0 0 0; box-shadow: 0 16px 48px var(--shadow-color); }

  .sec { padding: 96px 0; }
  .sec-tint { background: var(--primary-foreground); }
  .sec-frame { background: var(--frame); }

  /* Five places: person cards */
  .pc-row {
    margin-top: 48px; display: flex; gap: 24px; overflow-x: auto; scrollbar-width: none;
    scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding: 0 max(32px, calc((100cqw - 1280px) / 2 + 32px));
    scroll-padding: 0 max(32px, calc((100cqw - 1280px) / 2 + 32px));
  }
  .pc-row::-webkit-scrollbar { display: none; }
  .pc { flex: 0 0 480px; min-height: 600px; scroll-snap-align: start; display: flex; flex-direction: column; border-radius: var(--radius-frame); background: var(--frame); overflow: hidden; }
  .pc-text { padding: 48px 48px 0; display: flex; flex-direction: column; gap: 8px; }
  .pc-pic { flex: 1; box-sizing: border-box; padding: 24px 48px 48px; display: flex; align-items: center; justify-content: center; }
  .mini { width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 8px; }
  .tile { padding: 16px; border: 1px solid var(--border); border-radius: var(--radius-choice); background: var(--card); }
  .tile.line { padding: 12px; display: flex; align-items: center; gap: 12px; }
  .time { width: 40px; flex: none; }
  .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; line-height: 20px; font-weight: 500; }
  .bar { width: 96px; height: 8px; border-radius: var(--radius-pill); background: var(--border-strong); }
  .pill { flex: none; padding: 2px 8px; border-radius: var(--radius-pill); display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; font-size: 12px; line-height: 16px; font-weight: 500; }
  .dot { width: 6px; height: 6px; border-radius: var(--radius-pill); }
  .avatar { flex: none; width: 28px; height: 28px; box-sizing: border-box; border-radius: var(--radius-pill); background: var(--secondary); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; }
  .avatar.dashed { background: none; border: 1px dashed var(--border-strong); }
  .pc-navs { margin-top: 24px; display: flex; justify-content: flex-end; gap: 8px; }
  .pc-nav {
    width: 44px; height: 44px; border: 0; border-radius: var(--radius-pill); background: var(--secondary); color: var(--foreground);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    transition: opacity 150ms var(--ease-in-out), background-color 150ms var(--ease-in-out), transform 150ms var(--ease-out);
  }
  .pc-nav:disabled { opacity: 0.4; cursor: default; }

  /* One system: six items */
  .fx-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--border); }
  .fx { padding: 32px 32px 40px 0; display: flex; flex-direction: column; gap: 12px; border-bottom: 1px solid var(--border); }
  .fx:not(:nth-child(3n + 1)) { padding-left: 32px; border-left: 1px solid var(--border); }
  .fx a { min-height: 44px; display: inline-flex; align-items: center; gap: 12px; align-self: flex-start; }

  /* How it works (version B) */
  .hb-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: end; padding-bottom: 48px; border-bottom: 1px solid var(--border); }
  .hb-head-end { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .hb-body { margin-top: 48px; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px; align-items: stretch; }
  /* The 8px title-to-sentence gap is the button's bottom padding; the item's own bottom padding
     keeps a closed step as tall as an open one's frame, without clipping the sentence. */
  .hb-item { padding-bottom: 12px; border-radius: var(--radius-frame); background: transparent; transition: background-color 150ms var(--ease-in-out); }
  .hb-item.is-open { background: var(--frame); }
  .hb-step { width: 100%; padding: 20px 24px 8px; border: 0; background: none; color: var(--foreground); text-align: left; cursor: pointer; border-radius: var(--radius-frame); }
  .hb-reveal { display: grid; grid-template-rows: 0fr; opacity: 0; }
  .hb-reveal > div { min-height: 0; overflow: hidden; }
  .hb-reveal p { padding: 0 24px 8px; }
  .hb-item.is-open .hb-reveal { grid-template-rows: 1fr; opacity: 1; }
  .hb-shot { position: relative; min-height: 504px; border-radius: var(--radius-frame); background: var(--border); overflow: hidden; }
  .hb-pic { position: absolute; left: 64px; top: 24px; width: calc(100% + 120px); max-width: none; height: auto; border-radius: var(--radius-card) 0 0 0; opacity: 0; }
  .hb-pic.is-active { opacity: 1; }
  .hb-placeholder {
    height: 600px; box-sizing: border-box; padding: 24px; border: 1px dashed var(--border-strong); background: var(--card);
    display: flex; flex-direction: column; justify-content: center; gap: 8px;
  }

  /* Version 2: a taller top bar on the hero's grey, then the photo hero. */
  html:has(body.v2) { scroll-padding-top: 104px; }
  .v2 .nav { --nav-h: 88px; background: var(--secondary); }
  .v2 .nav.is-scrolled { background: var(--background); }
  .v2 .nav-row { height: 88px; }
  .v2 .brand span:last-child { font-size: 20px; line-height: 28px; font-weight: 700; letter-spacing: -0.02em; }
  .v2 .nav-links { flex: none; justify-content: flex-start; }
  .v2 .nav-links a { font-size: 16px; line-height: 24px; font-weight: 500; }
  .v2 .nav .btn-sm { font-size: 16px; line-height: 24px; padding: 0 20px; font-weight: 600; }
  .ph-wrap { background: var(--secondary); padding: 0 32px 32px; }
  .ph-frame { position: relative; height: 800px; border-radius: var(--radius-frame); overflow: hidden; background: var(--background); }
  /* The photo is graded darker in place, with no layer over it, so the white text reads. */
  /* The two faces sit at about 72% and 89% across the photo, so a narrow frame crops toward the right to keep them. */
  .ph-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 88% center; filter: brightness(0.55) saturate(0.9); }
  .ph-text { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; padding: 0 32px; text-align: center; color: var(--foreground); }
  /* Hero display size: larger than the type scale on purpose (approved 31 Oct on the canvas). */
  .ph-h1 { max-width: 900px; font-size: 64px; line-height: 64px; font-weight: 800; letter-spacing: -0.03em; text-transform: uppercase; text-wrap: balance; }
  .ph-sub { max-width: 560px; font-size: 20px; line-height: 28px; color: var(--primary); text-wrap: balance; }
  .ph-btns { margin-top: 8px; display: flex; gap: 12px; }
  .ph-btns .btn { font-weight: 600; }
  .ph-btns .btn-outline { border-color: var(--control-border); }

  /* How it works (version C): stacked cards in four greys */
  .hc-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: end; }
  .hc-stack { display: flex; flex-direction: column; gap: 24px; }
  .hc-card {
    position: sticky; top: calc(var(--nav-h, 72px) + 24px + var(--n) * 16px);
    min-height: 560px; border-radius: var(--radius-frame); overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    background: var(--frame); color: var(--foreground);
  }
  /* Scaled from the top edge, so the strip of each earlier card stays visible above the next. */
  .hc-card { transform: scale(var(--hc-scale, 1)); transform-origin: 50% 0; }
  .v2 .hc-card { --nav-h: 88px; }
  .hc-card:nth-child(2) { background: var(--border); }
  .hc-card:nth-child(3) { background: var(--border-strong); }
  .hc-text { padding: 48px; display: flex; flex-direction: column; gap: 16px; }
  .hc-pill {
    align-self: flex-start; padding: 4px 12px; border-radius: var(--radius-pill); background: var(--primary); color: var(--primary-foreground);
    font-size: 12px; line-height: 16px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
  }
  .hc-h3 { font: 600 36px/40px var(--font-sans); letter-spacing: -0.022em; }
  .hc-cta { margin-top: auto; padding-top: 32px; }
  .hc-pic { position: relative; margin: 16px 16px 16px 0; border-radius: var(--radius-card); background: var(--background); overflow: hidden; }
  .hc-pic img { position: absolute; left: 32px; top: 32px; width: calc(100% + 160px); max-width: none; height: auto; border-radius: var(--radius-card) 0 0 0; border: 1px solid var(--border); }
  .hc-placeholder {
    position: absolute; left: 32px; top: 32px; right: -32px; bottom: -32px; margin: 0; padding: 32px; box-sizing: border-box;
    border: 1px dashed var(--border-strong); border-radius: var(--radius-card) 0 0 0; background: var(--card);
    display: flex; flex-direction: column; justify-content: center; gap: 8px;
  }

  /* Version 3 hero: a full-width photo with the text on a white panel cut into its corner. */
  .pc-hero { padding: 16px 0 64px; }
  .stage { position: relative; max-width: 1440px; margin: 0 auto; height: 640px; padding: 0 32px; box-sizing: border-box; }
  .stage-pic { position: absolute; inset: 0 32px; border-radius: var(--radius-frame); overflow: hidden; background: var(--frame); }
  .stage-pic img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 70% center; }
  .panel {
    position: absolute; left: 32px; bottom: 0; width: 600px; padding: 48px 48px 0 0; box-sizing: border-box;
    background: var(--background); border-top-right-radius: var(--radius-frame);
    display: flex; flex-direction: column; align-items: flex-start; gap: 24px;
  }
  .panel-h1 { font-size: 48px; line-height: 52px; font-weight: 700; letter-spacing: -0.025em; text-wrap: balance; }
  .panel-ctas { margin-top: 8px; display: flex; gap: 12px; flex-wrap: wrap; }

  /* How it works (version D) */
  .hd-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px; align-items: stretch; }
  .hd-pic { position: relative; min-height: 560px; border-radius: var(--radius-frame); overflow: hidden; background: #f5f5f5; transition: background-color 200ms var(--ease-in-out); }
  /* One grey per step, light to dark. */
  .hd-pic[data-tone="1"] { background: #e5e5e5; }
  .hd-pic[data-tone="2"] { background: #d4d4d4; }
  .hd-pic[data-tone="3"] { background: #1b1b1b; }
  .hd-shot {
    position: absolute; left: 48px; right: 48px; top: 48px; bottom: 0; width: calc(100% - 96px); height: calc(100% - 48px);
    object-fit: cover; object-position: left top; box-sizing: border-box; margin: 0;
    border-radius: var(--radius-card) var(--radius-card) 0 0; box-shadow: 0 16px 48px var(--shadow-color); opacity: 0;
  }
  .hd-shot.is-active { opacity: 1; }
  .hd-placeholder { padding: 32px; border: 1px dashed var(--border-strong); background: var(--card); display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .hd-side { display: flex; flex-direction: column; }
  .hd-list { border-bottom: 1px solid var(--border); }
  .hd-step {
    position: relative; width: 100%; padding: 24px; border: 0; border-top: 1px solid var(--border); background: transparent;
    font: inherit; text-align: left; cursor: pointer; display: flex; flex-direction: column; gap: 8px; overflow: hidden;
    color: var(--muted-foreground); transition: background-color 150ms var(--ease-in-out), color 150ms var(--ease-in-out);
  }
  .hd-step.is-open { background: var(--frame); color: var(--foreground); }
  /* The line along the open step's top fills from the left when it opens. It never runs on its own. */
  .hd-bar { position: absolute; left: 0; right: 0; top: -1px; height: 2px; background: var(--foreground); transform: scaleX(0); transform-origin: left; }
  .hd-step.is-open .hd-bar { transform: scaleX(1); }
  .hd-title { display: flex; align-items: center; gap: 12px; font-size: 16px; line-height: 24px; font-weight: 600; }
  .hd-square { width: 8px; height: 8px; border-radius: 2px; background: currentColor; }
  .hd-body { padding-left: 20px; font-size: 16px; line-height: 24px; transition: color 150ms var(--ease-in-out); }
  .hd-step.is-open .hd-body { color: var(--primary); }
  .hd-cta { margin-top: 32px; }

  /* FAQ */
  .faq { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 64px; align-items: start; }
  .faq-list { border-top: 1px solid var(--border); }
  .faq-item { border-bottom: 1px solid var(--border); }
  .faq-item summary { list-style: none; cursor: pointer; min-height: 64px; padding: 16px 0; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .chev { flex: none; }
  .faq-a { display: grid; grid-template-rows: 1fr; }
  .faq-a > div { min-height: 0; overflow: hidden; }
  .faq-a p { padding: 0 40px 24px 0; }
  html.js .faq-item:not(.is-open) .faq-a { grid-template-rows: 0fr; opacity: 0; }
  html.js .faq-item.is-open .chev, html:not(.js) .faq-item[open] .chev { transform: rotate(180deg); }

  /* Closing band */
  .cta-sec { padding: 96px 0; }
  .cta-band {
    padding: 80px 48px; border-radius: var(--radius-frame); background: var(--background); color: var(--foreground);
    display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;
  }
  .cta-btns { margin-top: 8px; display: flex; gap: 12px; }

  /* Footer */
  .footer { padding: 0 0 48px; }
  .foot-cols { padding-top: 48px; border-top: 1px solid var(--border); display: grid; grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr)); gap: 48px; }
  .foot-cols h2 { margin-bottom: 4px; }
  .foot-cols ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .foot-cols ul a { min-height: 44px; display: inline-flex; align-items: center; font-size: 14px; line-height: 20px; color: var(--primary); }
  .foot-cols ul a:hover { text-decoration: underline; }
  .foot-base { padding-top: 24px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; }

  /* Hover: mouse and trackpad only, so phones get none. */
  @media (hover: hover) and (pointer: fine) {
    .nav-links a:hover, .nav-signin:hover { color: var(--foreground); }
    .btn-primary:hover { background: color-mix(in srgb, var(--primary) 85%, var(--background)); }
    .btn-outline:hover { background: var(--accent); }
    .pc-nav:not(:disabled):hover { background: var(--border); }
    .hb-item:not(.is-open):hover { background: var(--surface); }
    .hd-step:not(.is-open):hover { background: var(--surface); }
  }

  /* Movement, only for people who haven't asked for less. Without it everything shows at once. */
  @keyframes rf-up-8 { from { opacity: 0; transform: translateY(8px); } }
  @keyframes rf-up-16 { from { opacity: 0; transform: translateY(16px); } }
  @keyframes rf-word { from { opacity: 0; transform: translateY(8px); filter: blur(4px); } }
  .word { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    /* Text intro: every heading comes in word by word, 50ms apart, out of a slight blur.
       The hero's plays on load; the rest play once, when their section reveals.
       What follows a heading waits (--d) until its last word is on its way. */
    #hero-h .word { animation: rf-word 500ms var(--ease-out) calc(var(--w) * 50ms) both; }
    .hero-in { animation: rf-up-8 400ms var(--ease-out) calc(350ms + var(--i) * 60ms) both; }
    .hero-shot { animation: rf-up-16 500ms var(--ease-out) 470ms both; }

    html.js [data-words] .word {
      transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out), filter 500ms var(--ease-out);
      transition-delay: calc(var(--wd, 0ms) + var(--w) * 50ms);
    }
    html.js [data-words]:not(.is-in) .word { opacity: 0; transform: translateY(8px); filter: blur(4px); }

    html.js [data-reveal], html.js [data-reveal-group] > * {
      transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out);
      transition-delay: calc(var(--d, 0ms) + var(--i, 0) * var(--stagger, 0ms));
    }
    html.js [data-reveal]:not(.is-in), html.js [data-reveal-group]:not(.is-in) > * { opacity: 0; transform: translateY(12px); }

    /* Person cards fill in: once a card has landed, its rows come in 60ms apart, and each status
       pill settles in from 95% just after its row. Each card plays when it comes into view. */
    [data-fill] { --fd: calc(var(--d, 0ms) + var(--i, 0) * var(--stagger, 0ms) + 200ms); }
    [data-fill] .tile:nth-child(2) { --t: 1; }
    [data-fill] .tile:nth-child(3) { --t: 2; }
    html.js [data-fill] .tile {
      transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
      transition-delay: calc(var(--fd) + var(--t, 0) * 60ms);
    }
    html.js [data-fill] .pill {
      transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out);
      transition-delay: calc(var(--fd) + var(--t, 0) * 60ms + 150ms);
    }
    html.js [data-fill]:not(.is-in) .tile { opacity: 0; transform: translateY(8px); }
    html.js [data-fill]:not(.is-in) .pill { opacity: 0; transform: scale(0.95); }

    .hb-reveal { transition: grid-template-rows 200ms var(--ease-in-out), opacity 200ms var(--ease-in-out); }
    /* A light blur on the outgoing and incoming picture hides the double image mid-fade. */
    .hb-pic { transition: opacity 200ms var(--ease-in-out), filter 200ms var(--ease-in-out); }
    .hb-pic:not(.is-active) { filter: blur(2px); }
    .hd-shot { transition: opacity 200ms var(--ease-in-out), filter 200ms var(--ease-in-out); }
    .hd-shot:not(.is-active) { filter: blur(2px); }
    .hd-bar { transition: transform 400ms var(--ease-out); }
    /* The picture panel reveals once, but its grey still changes straight away when a step is picked. */
    html.js .hd-pic[data-reveal] {
      transition: opacity 500ms var(--ease-out) var(--d), transform 500ms var(--ease-out) var(--d), background-color 200ms var(--ease-in-out) 0ms;
