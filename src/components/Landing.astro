---
import Words from "./Words.astro";
import MobileMenu from "./MobileMenu.astro";
import DemoContent from "./DemoContent.astro";

// Ported from "Copy v1" on the Ravefort MVP design canvas (Landing-Copy-v1), with the
// Copy v1 motion spec: section reveals, hero load, person-card row, How it works (version B), FAQ.
// Version 2 swaps in two other canvas sections: the photo hero "After Ploy · 1, two at the desk"
// (Landing-Hero-Ploy) and How it works version C, stacked cards (Landing-HowItWorks-C).
// Version 3 uses "Hero with photo · C", text on a panel (Landing-Hero-Photo-C), and How it works
// version D, picture left and steps right (Landing-HowItWorks-D).
// Version 4 (Figma 258:9385 hero, 258:11101 step cards) is the homepage. Only the page passed
// `indexed` is open to search; the rest point their canonical at / and carry noindex.
// page="demo" renders the /demo request page: the same header and footer, with DemoContent as the body.
interface Props {
  version?: 1 | 2 | 3 | 4;
  indexed?: boolean;
  page?: "home" | "demo";
}
const { version = 1, indexed = false, page = "home" } = Astro.props;
const isDemo = page === "demo";
// On the demo page, in-page links (#product, #top) point back to the homepage.
const to = (hash: string) => (isDemo ? (hash === "#top" ? "/" : `/${hash}`) : hash);
// ponytail: links still to confirm before launch: the app's sign-in URL and Privacy/Terms pages.
const DEMO_URL = "/demo";
// Where the demo form posts, for example a Formspree URL. Empty opens an email with the details instead.
const DEMO_FORM_ENDPOINT = "";
const CONTACT_EMAIL = "hello@ravefort.com";
const TALK_URL = `mailto:${CONTACT_EMAIL}`;
// Empty hides the Sign in links until the app has a public address.
const SIGN_IN_URL = "";
// Empty hides the Log in buttons.
const LOGIN_URL = "https://app.ravefort.com/login";
// Empty hides the Legal column until the pages exist.
const PRIVACY_URL = "";
const TERMS_URL = "";

const heroH = "Never lose track of a patient again";
const heroSub =
  "Ravefort is the clinic system that books your patients, tells your team who’s due back, and shows you who returned and what each patient has spent with you over time.";
// The version 4 hero: retention and patient value lead, booking is one stage of the loop.
// Broad promise first (the whole clinic), with "the next visit" as Ravefort's angle; retention and value in the subhead.
const v4HeroH = "Run your whole clinic, from first booking to next visit.";
const v4HeroSub =
  "Ravefort brings booking, patient records, recall and reporting into one place. Your team keeps patients coming back, and you see who returned and what each patient has brought in.";
const heroSubPhoto =
  "Ravefort puts your appointments, patient records and recall list in one place, so your team always knows who’s due back.";

type Pill = { label: string; c: string };
const people: { title: string; body: string }[] = [
  { title: "Clinic owner", body: "See who came back this month, what they paid, and which patients you’re about to lose. You don’t have to ask the front desk." },
  { title: "Front desk", body: "See today’s patients on one screen, and book, check in or move them in a click." },
  { title: "Recall team", body: "Know who’s due back and what happened on the last call, so nobody is called twice." },
  { title: "Clinic admin", body: "Invite staff and give each person a role. They only see what that role allows, so front desk staff never see clinical notes." },
];
const deskRows: { time: string; name: string; pill: Pill }[] = [
  { time: "09:00", name: "Ngozi Adeyemi", pill: { label: "Checked in", c: "status-arrived" } },
  { time: "09:30", name: "Tunde Bakare", pill: { label: "Waiting", c: "status-scheduled" } },
  { time: "10:00", name: "Kola Bello", pill: { label: "No-show", c: "status-no-show" } },
];
const recallRows: { name: string; note: string; pill: Pill }[] = [
  { name: "Kola Bello", note: "Called Tue · no answer", pill: { label: "Call back Thu", c: "warning" } },
  { name: "Bola Johnson", note: "Check-up due in May", pill: { label: "To call", c: "info" } },
  { name: "Ngozi Adeyemi", note: "Booked on the call", pill: { label: "Booked", c: "success" } },
];
const teamRows = [
  { initials: "AO", name: "Amaka Okafor", role: "Owner" },
  { initials: "TA", name: "Tola Adebayo", role: "Front desk" },
];

const icons = {
  calendar: { rule: "evenodd", d: "M5.25 5.497a.75.75 0 0 1-.75-.75V4A1.5 1.5 0 0 0 3 5.5v1h10v-1A1.5 1.5 0 0 0 11.5 4v.75a.75.75 0 0 1-1.5 0V4H6v.747a.75.75 0 0 1-.75.75M10 2.5H6v-.752a.75.75 0 1 0-1.5 0V2.5a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h7a3 3 0 0 0 3-3v-6a3 3 0 0 0-3-3v-.75a.75.75 0 0 0-1.5 0zM3 8v3.5A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5V8z" },
  person: { rule: "nonzero", d: "M8 8.5c3.85 0 7 2.5 7 4.5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2c0-2 3.15-4.5 7-4.5M8 10c-1.61 0-3.064.526-4.092 1.234C2.798 12.001 2.5 12.733 2.5 13a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5c0-.267-.297-1-1.408-1.766C11.064 10.526 9.609 10 8 10m0-9a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7m0 1.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4" },
  recall: { rule: "evenodd", d: "M8 1.5a6.5 6.5 0 1 1-6.445 7.348.75.75 0 1 1 1.487-.194A5.001 5.001 0 1 0 4.43 4.5h1.32a.75.75 0 0 1 0 1.5h-3A.75.75 0 0 1 2 5.25v-3a.75.75 0 0 1 1.5 0v1.06A6.48 6.48 0 0 1 8 1.5" },
  whatsapp: { rule: "evenodd", d: "m4.843 10.944-.194 2.335a.204.204 0 0 0 .339.17l2.21-1.964.589.013L8 11.5c1.695 0 3.087-.44 4.020-1.177.89-.702 1.48-1.76 1.48-3.323s-.59-2.62-1.48-3.323C11.087 2.94 9.695 2.5 8 2.5s-3.087.44-4.020 1.177C3.09 4.38 2.5 5.437 2.5 7c0 1.648.656 2.742 1.648 3.448zm1.141 3.625 1.77-1.572Q7.875 13 8 13c3.866 0 7-2 7-6s-3.134-6-7-6-7 2-7 6c0 2.117.878 3.674 2.277 4.67l-.123 1.484a1.704 1.704 0 0 0 2.83 1.415" },
  upload: { rule: "evenodd", d: "M7.47 1.22a.75.75 0 0 1 1.06 0l2.5 2.5a.75.75 0 1 1-1.06 1.06L8.75 3.56v7.69a.75.75 0 0 1-1.5 0V3.56L6.03 4.78a.75.75 0 0 1-1.06-1.06zM1.75 13.5a.75.75 0 0 0 0 1.5h12.5a.75.75 0 0 0 0-1.5z" },
  chart: { rule: "nonzero", d: "M2 13.5h2.5v-5H2zm4.75 0h2.5v-11h-2.5zm4.75 0H14v-8h-2.5z" },
  shield: { rule: "evenodd", d: "m3.003 4.702 4.22-2.025a1.8 1.8 0 0 1 1.554 0l4.22 2.025a.89.89 0 0 1 .503.8V6a8.55 8.55 0 0 1-3.941 7.201l-.986.631a1.06 1.06 0 0 1-1.146 0l-.986-.63A8.55 8.55 0 0 1 2.5 6v-.498c0-.341.196-.652.503-.8m3.57-3.377L2.354 3.35A2.39 2.39 0 0 0 1 5.502V6a10.05 10.05 0 0 0 4.632 8.465l.986.63a2.56 2.56 0 0 0 2.764 0l.986-.63A10.05 10.05 0 0 0 15 6v-.498c0-.918-.526-1.755-1.354-2.152l-4.22-2.025a3.3 3.3 0 0 0-2.852 0M11.1 6.45a.75.75 0 1 0-1.2-.9L7.419 8.858 6.03 7.47a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.13-.08z" },
};
// In the order of the loop: book, follow up, bring back, see the numbers. Record import is covered
// in How it works (step 2), so the grid has room for Reports.
const features = [
  { icon: icons.calendar, title: "Appointments", body: "Book, check in, move or cancel from one shared schedule. Every visit goes on the patient’s record, and no-shows stand out on their own." },
  { icon: icons.recall, title: "Recall list", body: "Set how often patients should come back, once. Ravefort lists who’s due, each person once, and every call is noted." },
  { icon: icons.whatsapp, title: "WhatsApp messages", body: "Open a ready-made message to the patient in WhatsApp. Then note what happened on their record." },
  { icon: icons.chart, title: "Reports", body: "See how many patients were due, contacted, booked and came back, and what those visits brought in." },
  { icon: icons.person, title: "Patient value", body: "Every visit, booking and payment sits on one record, so you can see what each patient has been worth to your clinic over time." },
  { icon: icons.shield, title: "Team access", body: "Invite staff by email and give each person a role. Front desk staff never see clinical notes." },
];

// ponytail: step 1 has no screenshot yet; it shows the canvas's placeholder until one is made.
const steps: { title: string; body: string; src?: string; alt?: string; note?: string; more: string }[] = [
  { title: "Set up your clinic", body: "Sign up with your work email and your clinic is ready to use.", note: "From onboarding: the Create your clinic form, filled in.", more: "from your work email" },
  { title: "Bring your patients", body: "Your existing records come with you, checked before anything is saved.", src: "/shots/import-review.webp", alt: "Reviewing uploaded patient records before they are saved", more: "with the records you keep" },
  { title: "Set up recall", body: "Ravefort works out who’s due back, so no patient gets forgotten.", src: "/shots/recall.webp", alt: "The Recall board: patients due back sorted into to call, calling, call back and booked", more: "and see who’s due back" },
  { title: "Invite your team", body: "Everyone works from the same records and sees only what their role allows.", src: "/shots/team.webp", alt: "Team & access: each member with their role and status", more: "each with the right access" },
];
// Each step's video carries its own background, fills the whole picture panel and plays as a muted loop.
const v4Pictures = [
  { video: "/shots/welcome.mp4", alt: "Welcome to Ravefort: your clinic is ready, with patients and team invited." },
  { video: "/shots/import-records.mp4", alt: "Patient files uploading, then the import review marking each record ready, needs a fix or possible duplicate." },
  { video: "/shots/recall-funnel.mp4", alt: "Recall funnel showing patients due, contacted, booked and came back." },
  { video: "/shots/invite-team.mp4", alt: "Invite your team by work email and give each person their access." },
];
const OPEN_STEP = 1;

// ponytail: the set-up time [NEED: …] answer is hidden until it's filled in. Pricing isn't published
// (no pricing page); it's covered on the demo.
const faq = [
// Questions are phrased the way clinic owners search and ask AI assistants, so answers can be quoted
// as they are. They speak to clinics anywhere in Nigeria; the city focus stays in the footer and structured data.
  { q: "Who is Ravefort for?", a: "Clinics in Nigeria. It suits any clinic that sees patients more than once and wants them to come back." },
  { q: "Can any clinic in Nigeria use Ravefort?", a: "Yes. Ravefort runs in a web browser, so there’s nothing to install, wherever your clinic is. Book a demo and we’ll take you through it." },
  { q: "How does Ravefort reduce missed appointments?", a: "No-shows and late arrivals stand out in the day’s schedule, and the recall list shows everyone who’s overdue, each person once. Your team sends a ready-made WhatsApp message or calls, then notes what happened. Automatic reminders are coming next." },
  { q: "Can we bring our patient records from Excel or another system?", a: "Yes. Upload them as CSV or Excel files and check every row before it’s saved. Nothing is merged without you deciding." },
  { q: "Can I see how much each patient has brought into my clinic?", a: "Yes. Each patient’s record adds up what they’ve paid across every visit, so you can see who your most valuable patients are and who has stopped coming." },
  { q: "What reports does Ravefort give clinic owners?", a: "You see how many patients were due back, how many your team contacted, how many booked and how many came back, along with what those return visits brought in." },
  { q: "Does Ravefort message patients for us?", a: "Not yet. Your team opens a ready-made WhatsApp message or calls, then notes what happened on the patient’s record." },
  { q: "Who can see our patients’ information?", a: "Only the people you invite, and only what their role allows. Your records are kept apart from every other clinic’s." },
  { q: "How is “could be worth” worked out?", a: "It’s an estimate, and always labelled as one. A return only counts once the visit is done and paid." },
  { q: "What’s coming next?", a: "Online booking for patients and automatic reminders." },
  { q: "How long does set-up take?", a: "[NEED: typical set-up time.] We go through each step with you on your demo." },
  { q: "Do my staff need training to use Ravefort?", a: "[NEED: what training or onboarding staff get, and how long it takes.]" },
  { q: "Can we use Ravefort on a phone?", a: "[NEED: confirm whether the app works well in a phone browser.]" },
  { q: "What happens if our internet goes down?", a: "[NEED: what staff can still do offline, and what syncs when the connection is back.]" },
  { q: "How much does Ravefort cost?", a: "We don’t publish prices. We go through pricing with you on your demo, once we’ve seen how your clinic works." },
];
// Answers still waiting on facts stay off the page and out of what search engines read.
const answeredFaq = faq.filter((f) => !f.a.includes("[NEED"));
const navLinks = [
  ["#product", "Product"],
  ["#how", "How it works"],
  ["#who", "Who it’s for"],
  ["#questions", "FAQ"],
].map(([href, label]) => [to(href), label]);

const pill = (p: Pill) => `background: var(--${p.c}-soft);`;
const dot = (p: Pill) => `background: var(--${p.c});`;
const arrowPath =
  "M1.25 8A.75.75 0 0 1 2 7.25h10.19L9.47 4.53a.75.75 0 0 1 1.06-1.06l4 4a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 1 1-1.06-1.06l2.72-2.72H2A.75.75 0 0 1 1.25 8";
const chevronPath =
  "M2.97 5.47a.75.75 0 0 1 1.06 0L8 9.44l3.97-3.97a.75.75 0 1 1 1.06 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 0 1 0-1.06";
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#171717"/><text x="12" y="17" font-family="Inter,sans-serif" font-size="14" font-weight="600" text-anchor="middle" fill="#fafafa">R</text></svg>',
  );
const SITE = "https://ravefort.com";
// Search: clinics in Nigeria, Lagos first, then Abuja and Port Harcourt. The goal is a demo.
const CITIES = ["Lagos", "Abuja", "Port Harcourt"];
// The brand, then what it is and who it's for. The description opens by naming the platform.
// Titles cut off around 60 characters, snippets around 160; the cities live in the page.
const homeDescription =
  "Ravefort is clinic software for Nigeria. Run booking, patient records, recall and reports in one place, and see what each patient is worth. Book a demo.";
const title = isDemo ? "Book a demo - Ravefort Clinic Operations Software" : "Ravefort - Clinic Operations Software";
const description = isDemo
  ? "Book a demo of Ravefort. See how your team would book, follow up and bring patients back, what the owner’s reports show, and get pricing for your clinic."
  : homeDescription;
const pageUrl = isDemo ? `${SITE}/demo` : `${SITE}/`;

// What search engines and AI assistants read about the business and the product.
const areaServed = [...CITIES.map((name) => ({ "@type": "City", name, containedInPlace: { "@type": "Country", name: "Nigeria" } })), { "@type": "Country", name: "Nigeria" }];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Ravefort",
      url: SITE,
      email: CONTACT_EMAIL,
      description: homeDescription,
      areaServed,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "Ravefort",
      inLanguage: "en-NG",
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      name: "Ravefort",
      url: SITE,
      description: heroSub,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Clinic management",
      keywords: "clinic software, clinic management software, patient management software, patient retention, patient recall, clinic reports, patient lifetime value, appointment booking, WhatsApp patient messages, Lagos, Abuja, Port Harcourt, Nigeria",
      potentialAction: { "@type": "ScheduleAction", name: "Book a demo", target: `${SITE}/demo` },
      operatingSystem: "Web browser",
      areaServed,
      audience: { "@type": "BusinessAudience", audienceType: "Clinics in Lagos, Abuja, Port Harcourt and across Nigeria", geographicArea: areaServed },
      featureList: features.map((f) => `${f.title}: ${f.body}`),
      publisher: { "@id": `${SITE}/#organization` },
    },
    ...(isDemo ? [] : [{
      "@type": "FAQPage",
      mainEntity: answeredFaq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    }]),
  ],
};
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- A reload starts at the top. Restoring the old scroll position painted one frame before the
         page script ran (bar see-through, cards full size, text hidden), then everything snapped.
         A link to a section (#how) jumps straight there while loading; smooth scrolling is only for
         clicks on the page's own links. -->
    <script is:inline>
      {
        const root = document.documentElement;
        root.classList.add("js");
        history.scrollRestoration = "manual";
        root.style.scrollBehavior = "auto";
        addEventListener("load", () => requestAnimationFrame(() => root.style.removeProperty("scroll-behavior")));
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexed && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en-NG" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />
    <meta name="geo.region" content="NG" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ravefort" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ravefort: the clinic operations suite for teams who can’t afford to lose a patient. A medical director at her desk, looking at clinic reports on her computer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og.jpg`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    {version === 4 && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400&display=swap" />}
  </head>
  <body class={`v${version}${isDemo ? " page-demo" : ""}`}>
    <header class="nav" id="nav">
      <nav aria-label="Main" class="wrap nav-row">
        <a href={to("#top")} aria-label="Ravefort home" class="brand"><span class="logo" aria-hidden="true">R</span><span>Ravefort</span></a>
        <div class="nav-links">
          {navLinks.map(([href, label]) => <a href={href}>{label}</a>)}
        </div>
        <div class="nav-end">
          {SIGN_IN_URL && <a href={SIGN_IN_URL} class="nav-signin">Sign in</a>}
          {LOGIN_URL && <a href={LOGIN_URL} class="btn btn-outline btn-sm">Log in</a>}
          <a href={DEMO_URL} class="btn btn-primary btn-sm">Book a demo</a>
          {version === 4 && <MobileMenu links={navLinks} demoUrl={DEMO_URL} loginUrl={LOGIN_URL} />}
        </div>
      </nav>
    </header>

    <main id="top">
      {isDemo ? (
        <DemoContent contactEmail={CONTACT_EMAIL} formEndpoint={DEMO_FORM_ENDPOINT} privacyUrl={PRIVACY_URL} />
      ) : (
      <>
      {version === 4 && (
        <div class="v4-hero-wrap">
          <section class="v4-hero" aria-labelledby="hero-h">
            <div class="v4-hero-photo">
              <picture>
                <source media="(max-width: 760px)" srcset="/photos/hero-director-mobile-828.webp 828w, /photos/hero-director-mobile-1116.webp 1116w" sizes="100vw" width="1116" height="2000" />
                <img src="/photos/hero-director-2400.webp" srcset="/photos/hero-director-1280.webp 1280w, /photos/hero-director-2400.webp 2400w" sizes="100vw" width="2400" height="1340" fetchpriority="high" alt="A medical director at her desk, looking at clinic reports on her computer." />
              </picture>
            </div>
            <div class="wrap v4-hero-content">
              <h1 id="hero-h"><Words text={v4HeroH} /></h1>
              <p class="hero-in" style="--i: 0">{v4HeroSub}</p>
              <div class="v4-hero-buttons hero-in" style="--i: 1">
                <a class="btn btn-primary" href={DEMO_URL}>Book a demo</a>
              </div>
            </div>
          </section>
        </div>
      )}
      {version === 2 && (
      <div class="ph-wrap">
        <section class="ph-frame theme-dark" aria-labelledby="hero-h">
          <img class="ph-img" src="/photos/hero-desk.webp" width="1024" height="572" fetchpriority="high" alt="A clinician at her desk smiling at the screen while a colleague leans in beside her" />
          <div class="ph-text">
            <h1 id="hero-h" class="ph-h1"><Words text={heroH} /></h1>
            <p class="ph-sub hero-in" style="--i: 0">{heroSubPhoto}</p>
            <div class="ph-btns hero-in" style="--i: 1">
              <a class="btn btn-primary" href={DEMO_URL}>Book a demo</a>
              <a class="btn btn-outline" href={TALK_URL}>Talk to us</a>
            </div>
          </div>
        </section>
      </div>
      )}
      {version === 3 && (
      <section class="pc-hero" aria-labelledby="hero-h">
        <div class="stage">
          <div class="stage-pic">
            <img src="/photos/hero-clinician.webp" width="1024" height="572" fetchpriority="high" alt="A smiling clinician in a white coat sits at a desk, pen in hand, looking at a computer screen." />
          </div>
          <div class="panel">
            <h1 id="hero-h" class="panel-h1"><Words text={heroH} /></h1>
            <p class="hero-sub hero-in" style="max-width: 26em; --i: 0">{heroSub}</p>
            <div class="panel-ctas hero-in" style="--i: 1">
              <a class="btn btn-primary" href={DEMO_URL}>Book a demo</a>
              <a class="btn btn-outline" href={TALK_URL}>Talk to us</a>
            </div>
          </div>
        </div>
      </section>
      )}
      {version === 1 && (
      <section class="hero" aria-labelledby="hero-h">
        <div class="wrap hero-text">
          <h1 id="hero-h" class="t-display">
            <Words text={heroH} />
          </h1>
          <p class="hero-sub hero-in" style="--i: 0">{heroSub}</p>
          <div class="hero-ctas hero-in" style="--i: 1">
            <a class="btn btn-primary" href={DEMO_URL}>Book a demo</a>
            <a class="btn btn-outline" href={TALK_URL}>Talk to us</a>
