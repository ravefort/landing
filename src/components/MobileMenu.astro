---
import Bars from "../assets/gravity/bars.svg";
import Xmark from "../assets/gravity/xmark.svg";
import ArrowUpRight from "../assets/gravity/arrow-up-right.svg";
interface Props {
  links: string[][];
  demoUrl: string;
}
const { links, demoUrl } = Astro.props;
---

<button class="menu-trigger" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
  <Bars width="24" height="24" aria-hidden="true" />
</button>

<dialog id="mobile-menu" class="menu-sheet" aria-label="Navigation">
  <div class="menu-head">
    <a class="brand menu-brand" href="#top" aria-label="Ravefort home"><span class="logo" aria-hidden="true">R</span><span>Ravefort</span></a>
    <button class="menu-close" type="button" aria-label="Close menu" autofocus><Bars class="menu-icon-bars" width="24" height="24" aria-hidden="true" /><Xmark class="menu-icon-x" width="24" height="24" aria-hidden="true" /></button>
  </div>
  <nav class="menu-links" aria-label="Mobile">
    {links.map(([href, label], i) => <a href={href} style={`--menu-delay: ${i * 40}ms`}>{label}<ArrowUpRight width="20" height="20" aria-hidden="true" /></a>)}
  </nav>
  <div class="menu-bottom"><a class="menu-demo" href={demoUrl}>Book a demo</a></div>
</dialog>

<script>
  const trigger = document.querySelector<HTMLButtonElement>(".menu-trigger");
  const sheet = document.querySelector<HTMLDialogElement>(".menu-sheet");
  if (trigger && sheet) {
    trigger.addEventListener("click", () => {
      if (sheet.open) return;
      sheet.showModal();
      trigger.setAttribute("aria-expanded", "true");
    });
    sheet.querySelector(".menu-close")?.addEventListener("click", () => sheet.close());
    sheet.querySelectorAll("a").forEach(link => link.addEventListener("click", () => sheet.close()));
    sheet.addEventListener("close", () => trigger.setAttribute("aria-expanded", String(sheet.open)));
    const desktop = matchMedia("(min-width: 761px)");
    desktop.addEventListener("change", () => { if (desktop.matches && sheet.open) sheet.close(); });
  }
</script>

<style>
  .menu-trigger, .menu-close { width: 44px; height: 44px; flex: none; position: relative; display: grid; place-items: center; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; }
  .menu-trigger { display: none; }
  .menu-demo { transition: transform 150ms var(--ease-out); }
  .menu-demo:active { transform: scale(.97); }
  .menu-sheet { position: fixed; inset: 0; margin: 0; padding: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; box-sizing: border-box; border: 0; background: #fff; color: var(--foreground); opacity: 0; overflow: hidden; overscroll-behavior: contain; transition: opacity 250ms var(--ease-out), display 250ms allow-discrete, overlay 250ms allow-discrete; }
  .menu-sheet[open] { display: flex; flex-direction: column; opacity: 1; }
  @starting-style { .menu-sheet[open] { opacity: 0; } }
  .menu-sheet::backdrop { background: transparent; }
  .menu-head { height: 88px; flex: none; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .menu-head .menu-brand { color: #171717; }
  .menu-close svg { position: absolute; inset: 10px; transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out); }
  .menu-close .menu-icon-bars { opacity: 1; transform: rotate(0); }
  .menu-close .menu-icon-x { opacity: 0; transform: rotate(-45deg); }
  .menu-sheet[open] .menu-icon-bars { opacity: 0; transform: rotate(45deg); }
  .menu-sheet[open] .menu-icon-x { opacity: 1; transform: rotate(0); }
  @starting-style {
    .menu-sheet[open] .menu-icon-bars { opacity: 1; transform: rotate(0); }
    .menu-sheet[open] .menu-icon-x { opacity: 0; transform: rotate(-45deg); }
  }
  .menu-links { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 16px; }
  .menu-links a { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--border); color: #171717; font: 500 16px/24px var(--font-sans); }
  .menu-links a svg { flex: none; color: var(--muted-foreground); }
  .menu-links a { opacity: 0; transform: translateY(8px); transition: opacity 150ms var(--ease-out), transform 150ms var(--ease-out); }
  .menu-sheet[open] .menu-links a { opacity: 1; transform: translateY(0); transition-duration: 240ms; transition-delay: var(--menu-delay, 160ms); }
  @starting-style {
    .menu-sheet[open] .menu-links a { opacity: 0; transform: translateY(8px); }
  }
  .menu-bottom { flex: none; padding: 24px 16px max(16px, env(safe-area-inset-bottom)); background: #fff; }
  .menu-demo { display: flex; align-items: center; justify-content: center; min-height: 44px; border-radius: var(--radius-pill); background: #171717; color: #fafafa; font: 500 16px/24px var(--font-sans); }
  :global(html:has(.menu-sheet[open])) { overflow: hidden; }
  :global(html.js .v4 .nav-end > .btn-sm) { display: inline-flex; }
  @media (max-width: 760px) {
    :global(html.js) .menu-trigger { display: grid; color: #fff; }
    :global(html.js .v4 .nav-end > .btn-sm) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-sheet { transition-duration: 100ms; }
    .menu-links a, .menu-sheet[open] .menu-links a { transform: none; transition-duration: 100ms; transition-delay: 0ms; }
    .menu-demo:active { transform: none; }
    .menu-close svg { transition-duration: 100ms; }
    .menu-close .menu-icon-bars, .menu-close .menu-icon-x, .menu-sheet[open] .menu-icon-bars, .menu-sheet[open] .menu-icon-x { transform: none; }
    @starting-style {
      .menu-sheet[open] .menu-icon-bars, .menu-sheet[open] .menu-icon-x, .menu-sheet[open] .menu-links a { transform: none; }
    }
  }
</style>
