---
// Ported from "L1 A · Landing page, drawn product mocks" on the Ravefort MVP design canvas.
// ponytail: links still to confirm before launch: the demo booking link, the contact email,
// the app's sign-in URL, and Privacy/Terms pages.
const DEMO_URL = "#demo";
const CONTACT_EMAIL = "hello@ravefort.com";
// Empty hides the Sign in links until the app has a public address.
const SIGN_IN_URL = "";

const badge = (c: string) => `background: var(--${c}-soft); color: var(--${c});`;
const muted = "background: var(--accent); color: var(--muted-foreground);";

const dayRows = [
  { time: "09:00", name: "Chidi Okafor", reason: "Check-up", status: "Arrived", badge: badge("status-arrived") },
  { time: "09:30", name: "Ngozi Eze", reason: "Scale and polish", status: "In care", badge: badge("status-in-care") },
  { time: "10:15", name: "Aisha Bello", reason: "Check-up", status: "Late", badge: badge("status-late") },
  { time: "11:00", name: "Tunde Bakare", reason: "Filling", status: "Scheduled", badge: badge("status-scheduled") },
  { time: "11:30", name: "Emeka Obi", reason: "Consultation", status: "Scheduled", badge: badge("status-scheduled") },
];
const importRows = [
  { name: "Funmi Adeyemi", phone: "0803 412 7781", status: "Ready", note: "", badge: badge("success") },
  { name: "Kelechi Nwosu", phone: "0805 119", status: "Needs a fix", note: "Phone number looks too short", badge: badge("warning") },
  { name: "Ngozi Eze", phone: "0812 660 2394", status: "Possible match", note: "Same name and date of birth as a patient you have", badge: badge("info") },
];
const recallRows = [
  { name: "Bola Johnson", reason: "Check-up overdue by 4 months", last: "Not contacted yet" },
  { name: "Ifeoma Uche", reason: "Crown recommended, not booked", last: "No answer · 2 days ago" },
  { name: "Samuel Ade", reason: "Check-up overdue by 7 months", last: "Call back Friday" },
  { name: "Zainab Musa", reason: "Check-up overdue by 2 months", last: "Not contacted yet" },
];
const teamRows = [
  { email: "amaka@yourclinic.com", role: "Owner", status: "Active", badge: badge("success") },
  { email: "tola@yourclinic.com", role: "Front Desk", status: "Active", badge: badge("success") },
  { email: "bisi@yourclinic.com", role: "Manager", status: "Invitation sent", badge: muted },
  { email: "kemi@yourclinic.com", role: "Recall", status: "Invitation sent", badge: muted },
];
const pillars = [
  { title: "One record for each patient", body: "Bookings, visits and payments land on the same person, from their first enquiry onward." },
  { title: "Follow-up with a trail", body: "Every call and WhatsApp message is logged with what happened, so nobody is called twice and nobody is missed." },
  { title: "Numbers you can trust", body: "Estimates are labelled as estimates. Money only counts once a payment is approved." },
];
const stats = [
  { label: "Active patients", value: "2,712", note: "From your uploaded records" },
  { label: "Due to come back", value: "618", note: "None contacted yet" },
  { label: "Overdue check-ups", value: "About ₦3,090,000", note: "An estimate if they return, not money yet" },
];
const steps = [
  { title: "Create your clinic", body: "Your work email, your name and your clinic’s name." },
  { title: "Upload your patient records", body: "CSV files from the system you use today. You check each row." },
  { title: "Invite your team", body: "Your manager, front desk and recall team, each with their own role." },
  { title: "Set your recall interval", body: "How often patients should come back for a check-up." },
  { title: "See who to call back", body: "Your list of patients due to come back, ready to work." },
];
const faq = [
  { q: "Who is Ravefort for?", a: "Clinics in Nigeria and across West Africa that book appointments and want patients to come back. We’re starting with dental clinics." },
  { q: "Does Ravefort work for clinics in Nigeria and the rest of West Africa?", a: "Yes. Ravefort runs in your browser, so there’s nothing to install. Your team reaches patients on WhatsApp, and estimated values are shown in naira." },
  { q: "What happens to the records we already have?", a: "You upload them as CSV files and check every row before anything is saved. Possible duplicates are shown to you; nothing is merged automatically." },
  { q: "Does Ravefort send messages for us?", a: "No. Your team sends each WhatsApp message from their own WhatsApp, starting from a message you’ve set up. Ravefort records that it was opened, never that it was delivered." },
  { q: "Who can see our patients’ information?", a: "Only people you invite, and only what their role allows. Your clinic’s records are kept apart from every other clinic’s." },
  { q: "How do you count money we get back?", a: "Before a patient returns, amounts are estimates and labelled that way. A return counts once the visit is done and the payment is approved by your front desk." },
  { q: "How much does it cost?", a: "Book a demo and we’ll talk it through." },
];
const navLinks = [
  ["#front-desk", "Front desk"],
  ["#patients", "Patients"],
  ["#recall", "Recall"],
  ["#how", "How it works"],
  ["#faq", "Questions"],
];

const whatsappPath =
  "m4.843 10.944-.194 2.335a.204.204 0 0 0 .339.17l2.21-1.964.589.013L8 11.5c1.695 0 3.087-.44 4.02-1.177.89-.702 1.48-1.76 1.48-3.323s-.59-2.62-1.48-3.323C11.087 2.94 9.695 2.5 8 2.5s-3.087.44-4.02 1.177C3.09 4.38 2.5 5.437 2.5 7c0 1.648.656 2.742 1.648 3.448zm1.141 3.625 1.77-1.572Q7.875 13 8 13c3.866 0 7-2 7-6s-3.134-6-7-6-7 2-7 6c0 2.117.878 3.674 2.277 4.67l-.123 1.484a1.704 1.704 0 0 0 2.83 1.415";
const phonePath =
  "M14.125 9.833a3.7 3.7 0 0 0-1.592-1.22l-.032-.012a2.88 2.88 0 0 0-2.795.37l-.36.269a.5.5 0 0 1-.653-.047L6.807 7.307a.5.5 0 0 1-.047-.654l.27-.36A2.88 2.88 0 0 0 7.4 3.5l-.013-.032a3.7 3.7 0 0 0-1.22-1.592l-.19-.143a2.33 2.33 0 0 0-2.135-.346l-.19.063A3.48 3.48 0 0 0 1.450 3.653a4.9 4.9 0 0 0-.105 2.725 9.760 9.760 0 0 0 2.567 4.533l1.178 1.178a9.760 9.760 0 0 0 4.533 2.566c.9.226 1.845.19 2.725-.104a3.480 3.480 0 0 0 2.204-2.203l.063-.19a2.330 2.330 0 0 0-.347-2.135zM5.159 3.219l-.19-.143a.65.65 0 0 0-.596-.096l-.19.063c-.538.18-.96.602-1.14 1.140a3.200 3.200 0 0 0-.069 1.788A8.100 8.100 0 0 0 5.100 9.723l1.178 1.178a8.100 8.100 0 0 0 3.752 2.125c.59.147 1.210.123 1.787-.069.539-.18.961-.602 1.141-1.140l.063-.19a.65.65 0 0 0-.096-.596l-.143-.19a2.030 2.030 0 0 0-.872-.668l-.032-.013a1.200 1.200 0 0 0-1.163.154l-.36.27a2.180 2.180 0 0 1-2.849-.203L5.620 8.495a2.180 2.180 0 0 1-.203-2.850l.27-.36c.25-.334.309-.774.154-1.162l-.013-.032a2.030 2.030 0 0 0-.668-.872";
const arrowPath =
  "M1.25 8A.75.75 0 0 1 2 7.25h10.19L9.47 4.53a.75.75 0 0 1 1.06-1.060l4 4a.75.75 0 0 1 0 1.060l-4 4a.75.75 0 1 1-1.06-1.060l2.72-2.720H2A.75.75 0 0 1 1.25 8";
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" rx="6" fill="#e5e5e5"/><text x="12" y="17" font-family="Inter,sans-serif" font-size="14" font-weight="600" text-anchor="middle" fill="#171717">R</text></svg>',
  );
const SITE = "https://ravefort.com";
const title = "Ravefort · Dental clinic software for Nigeria and West Africa";
// Search snippets cut off around 160 characters.
const description =
  "Front desk and patient recall software for dental clinics in Nigeria and West Africa. Book appointments, keep records and bring patients back on WhatsApp.";
const lead =
  "Ravefort is front desk and patient recall software for clinics in Nigeria and West Africa. It keeps your clinic's day, your patient records and your follow-up calls in one place, so your team knows who to see today and who to call back.";

// What search engines and AI assistants read about the business and the product.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      name: "Ravefort",
      url: SITE,
      email: CONTACT_EMAIL,
      description,
      areaServed: [{ "@type": "Country", name: "Nigeria" }, { "@type": "Place", name: "West Africa" }],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "Ravefort",
      inLanguage: "en-NG",
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": "SoftwareApplication",
      name: "Ravefort",
      url: SITE,
      description: lead,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Dental practice management",
      operatingSystem: "Web browser",
      areaServed: [{ "@type": "Country", name: "Nigeria" }, { "@type": "Place", name: "West Africa" }],
      audience: { "@type": "BusinessAudience", audienceType: "Dental clinics and other clinics that book appointments" },
      featureList: [
        "Today's appointment list with booking, check-in, moving and cancelling",
        "WhatsApp messages to patients from the front desk",
        "Patient record import from CSV files, with every row checked and no automatic merging",
        "Recall list of patients with overdue check-ups or unbooked treatment",
        "Estimated value of returning patients, shown in naira and labelled as an estimate",
        "Role-based team access, with each clinic's records kept apart",
      ],
      publisher: { "@id": `${SITE}/#organization` },
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
};
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="alternate" hreflang="en-NG" href={`${SITE}/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <meta name="geo.region" content="NG" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ravefort" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ravefort: run your front desk, bring your patients back." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-row">
        <a href="#top" class="brand"><span class="logo">R</span><span>Ravefort</span></a>
        <nav aria-label="Main" class="nav-links">
          {navLinks.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <div class="row gap-2">
          {SIGN_IN_URL && <a href={SIGN_IN_URL} class="btn btn-ghost">Sign in</a>}
          <a href={DEMO_URL} class="btn btn-primary">Book a demo</a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap stack-48">
          <div class="stack-16 measure">
            <span class="eyebrow">New · Piloting with our first dental clinic</span>
            <h1 class="hero-h">Run your front desk.<br />Bring your patients back.</h1>
            <p class="lead">{lead}</p>
            <div class="row wrap-row gap-3 pt-2">
              <a href={DEMO_URL} class="btn btn-primary btn-lg">
                Book a demo
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d={arrowPath} clip-rule="evenodd"></path></svg>
              </a>
              <a href="#how" class="btn btn-ghost btn-lg secondary">See how it works</a>
            </div>
          </div>

          <div class="frame shadow" aria-hidden="true">
            <div class="app">
              <aside class="hide-sm sidebar">
                <p class="sidebar-title">Your clinic</p>
                {["Overview", "Today", "Patients", "Recall", "Team & access"].map((item) => (
                  <span class:list={["side-item", { active: item === "Today" }]}>{item}</span>
                ))}
              </aside>
              <div class="app-main">
                <div class="row between gap-4">
                  <div>
                    <p class="h-lg">Today</p>
                    <p class="sm muted">Tuesday · 14 appointments · 3 arrived</p>
                  </div>
                  <span class="btn btn-primary">Book appointment</span>
                </div>
                <div class="scroll">
                  <div class="table" style="min-width: 560px">
                    {dayRows.map((r) => (
                      <div class="tr" style="grid-template-columns: 72px minmax(0,1.4fr) minmax(0,1fr) 120px">
                        <span class="mono muted">{r.time}</span>
                        <span class="medium">{r.name}</span>
                        <span class="muted">{r.reason}</span>
                        <span class="badge" style={r.badge}>{r.status}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap stack-64">
          <p class="statement">
            Most patients don't leave a clinic. They forget to come back.{" "}
            <span class="muted">Ravefort shows your team who is due, helps them reach out, and keeps a record of every call and every return.</span>
          </p>
          <div class="grid-3">
            {pillars.map((p) => (
              <div class="ruled stack-8">
                <h2 class="h-base">{p.title}</h2>
                <p class="muted">{p.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="front-desk" class="section bt">
        <div class="wrap stack-48">
          <div class="split">
            <h2 class="h-title">Run the day from one list</h2>
            <div class="stack-16">
              <p class="muted">See today's appointments as they happen. Book, check in, move or cancel in a few clicks, and message a patient on WhatsApp without leaving the list.</p>
              <p class="sm muted">Front desk · Today · Booking · Check-in · WhatsApp</p>
            </div>
          </div>
          <div class="frame pad" aria-hidden="true">
            <div class="split gap-24">
              <div class="stack-12">
                <p class="sm semibold">Move appointment</p>
                <div class="card stack-12 sm">
                  <div class="row between gap-4"><span class="muted">Patient</span><span>Tunde Bakare</span></div>
                  <div class="row between gap-4"><span class="muted">Was</span><span class="muted strike">Tue 10:15</span></div>
                  <div class="row between gap-4"><span class="muted">Now</span><span class="medium">Thu 14:00</span></div>
                </div>
              </div>
              <div class="stack-12">
                <p class="sm semibold row gap-2">
                  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d={whatsappPath} clip-rule="evenodd"></path></svg>
                  WhatsApp message
                </p>
                <div class="card stack-12">
                  <p class="sm">Hi Tunde, your appointment has moved to Thursday at 2:00pm. Reply here if that time doesn't work.</p>
                  <div class="row end"><span class="btn btn-primary">Open WhatsApp</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="patients" class="section bt">
        <div class="wrap stack-48">
          <div class="split">
            <h2 class="h-title">Bring your patient records with you</h2>
            <div class="stack-16">
              <p class="muted">Upload the records you already keep as CSV files. Check every row before anything is saved, fix what's wrong, and decide on possible duplicates yourself. Nothing is merged without you.</p>
              <p class="sm muted">Patients · Upload · Review rows · Check for matches</p>
            </div>
          </div>
          <div class="frame pad stack-16" aria-hidden="true">
            <div class="row wrap-row gap-2 sm">
              <span class="semibold" style="margin-right: 8px">Check your patient records</span>
              <span class="badge" style={badge("success")}>2,698 ready</span>
              <span class="badge" style={badge("warning")}>9 need a fix</span>
              <span class="badge" style={badge("info")}>5 possible matches</span>
            </div>
            <div class="scroll">
              <div class="table" style="min-width: 560px">
                {importRows.map((r) => (
                  <div class="tr" style="grid-template-columns: minmax(0,1fr) 140px 130px minmax(0,1.4fr)">
                    <span class="medium">{r.name}</span>
                    <span class="mono muted">{r.phone}</span>
                    <span class="badge" style={r.badge}>{r.status}</span>
                    <span class="muted">{r.note}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="recall" class="section bt">
        <div class="wrap stack-48">
          <div class="split">
            <h2 class="h-title">Know who to call back</h2>
            <div class="stack-16">
              <p class="muted">Set your check-up interval once. Ravefort lists everyone with an overdue check-up or treatment they haven't booked, each person once. Your team calls or messages them and records what happened.</p>
              <p class="sm muted">Recall · Due to come back · Call or WhatsApp · Results</p>
            </div>
          </div>
          <div class="frame pad" aria-hidden="true">
            <div class="scroll">
              <div class="table" style="min-width: 640px">
                {recallRows.map((r) => (
                  <div class="tr" style="grid-template-columns: minmax(0,1fr) minmax(0,1.3fr) minmax(0,1fr) 168px">
                    <span class="medium">{r.name}</span>
                    <span class="muted">{r.reason}</span>
                    <span class="muted">{r.last}</span>
                    <span class="row end gap-2">
                      <span class="chip">
                        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d={phonePath} clip-rule="evenodd"></path></svg>
                        Call
                      </span>
                      <span class="chip">
                        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d={whatsappPath} clip-rule="evenodd"></path></svg>
                        WhatsApp
                      </span>
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="overview" class="section bt">
        <div class="wrap stack-48">
          <div class="split">
            <h2 class="h-title">See what follow-up is worth</h2>
            <div class="stack-16">
              <p class="muted">Your Overview shows who is due to come back and what their return could be worth, clearly marked as an estimate. A return only counts once the visit is done and the payment is approved.</p>
              <p class="sm muted">Overview · Due to come back · Estimated value</p>
            </div>
          </div>
          <div class="grid-3 gap-16" aria-hidden="true">
            {stats.map((s) => (
              <div class="frame pad stack-8">
                <p class="sm muted">{s.label}</p>
                <p class="h-title">{s.value}</p>
                <p class="xs muted">{s.note}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="team" class="section bt">
        <div class="wrap stack-48">
          <div class="split">
            <h2 class="h-title">The right access for each person</h2>
            <div class="stack-16">
              <p class="muted">Invite your team by email and give each person a role that decides what they can see and do. Each clinic's records stay apart from every other clinic's.</p>
              <p class="sm muted">Team &amp; access · Invitations · Roles</p>
            </div>
          </div>
          <div class="frame pad" aria-hidden="true">
            <div class="scroll">
              <div class="table" style="min-width: 520px">
                {teamRows.map((r) => (
                  <div class="tr" style="grid-template-columns: minmax(0,1.6fr) minmax(0,1fr) 140px">
                    <span>{r.email}</span>
                    <span class="muted">{r.role}</span>
                    <span class="badge" style={r.badge}>{r.status}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="how" class="section bt">
        <div class="wrap stack-48">
          <div class="stack-8 measure">
            <h2 class="h-title">Five steps to your first recall list</h2>
            <p class="muted">After your demo, you set it up yourself in your browser. Nothing to install.</p>
          </div>
          <ol class="steps">
            {steps.map((s, i) => (
              <li class="frame step stack-8">
                <span class="step-n">{i + 1}</span>
                <span class="h-base">{s.title}</span>
                <span class="sm muted">{s.body}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section bt">
        <div class="wrap">
          <div class="stack-8 measure">
            <h2 class="h-title">Built inside a working clinic</h2>
            <p class="muted">Ravefort is designed with Luxe Dental, our first clinic, from their real front desk and follow-up work. Every screen is tested against how their team actually spends the day.</p>
          </div>
          <!-- ponytail: a quote from the Luxe Dental team goes here once they agree to share one. -->
        </div>
      </section>

      <section id="faq" class="section bt">
        <div class="wrap stack-48">
          <h2 class="h-title">Questions clinics ask us</h2>
          <dl class="faq">
            {faq.map((f) => (
              <div class="ruled stack-8">
                <dt class="h-base">{f.q}</dt>
                <dd class="muted">{f.a}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section id="demo" class="section bt">
        <div class="wrap stack-24 cta">
          <h2 class="hero-h">See Ravefort with your own clinic in mind.</h2>
          <p class="muted" style="max-width: 560px">Book a demo and we'll walk you through the front desk, the recall list and how setup works.</p>
          <div class="row wrap-row gap-3" style="justify-content: center">
            <a href={`mailto:${CONTACT_EMAIL}?subject=Ravefort%20demo`} class="btn btn-primary btn-lg">Book a demo</a>
            <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-outline btn-lg">Talk to us</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="bt footer">
      <div class="wrap foot">
        <div class="stack-8">
          <span class="brand"><span class="logo">R</span><span>Ravefort</span></span>
          <p class="sm muted">The front desk and follow-up system for clinics.</p>
        </div>
        <nav aria-label="Product" class="foot-col">
          <span class="semibold">Product</span>
          <a href="#front-desk">Front desk</a>
